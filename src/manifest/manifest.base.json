{
  "manifest_version": 3,
  "name": "Webpage to ePub",
  "version": "0.0.1",
  "description": "Convert the current web page into an ePub file.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save page as ePub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["<all_urls>"]
}
