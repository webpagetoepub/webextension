{
  "manifest_version": 3,
  "name": "Webpage to ePub",
  "version": "0.0.1",
  "description": "Convert the current web page into an ePub file.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save page as ePub"
  },
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["<all_urls>"]
}
