{
  "name": "webpage2epub-webextension",
  "version": "0.0.1",
  "description": "Convert webpage to EPUB",
  "keywords": [
    "epub",
    "epub-generation",
    "html2epub",
    "webextension"
  ],
  "license": "MIT",
  "author": "Carlson Santana Cruz",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,js,json,html}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,js,json,html}\"",
    "test": "playwright test"
  },
  "dependencies": {
    "html2epub": "github:webpagetoepub/html2epub#bf6d34c395b327426b6bfea596f50dd978b55558",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "fflate": "^0.8.2",
    "geckodriver": "^6.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "selenium-webdriver": "^4.45.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.17.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "geckodriver@6.1.0": true
  }
}
